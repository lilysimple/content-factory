# ── модель ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

# ── семь ботов ────────────────────────────────────────────────────────
# У ассистента обязательно /setprivacy → Disable
BOT_ASSISTANT=
BOT_RESEARCH=
BOT_STRATEGY=
BOT_EDITOR=
BOT_REELS=
BOT_DESIGN=
BOT_PUBLISHER=

# ── безопасность ──────────────────────────────────────────────────────
# Через запятую. Пусто = принимать любой чат (только для локальной отладки)
ALLOWED_CHATS=
MINIAPP_SECRET=change-me

# ── окружение ─────────────────────────────────────────────────────────
BRANDS_PATH=./Brands
DB_PATH=./factory.db
DEFAULT_TZ=Europe/Moscow
MINIAPP_URL=
LLM_BUDGET_PER_TENANT_DAY=200
