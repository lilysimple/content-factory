# ── модель ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=high

# Модель и усилие по ролям. Пусто = берётся общее значение выше.
# Распаковка и стратегия это суждение, публикация это форматирование.
MODEL_RESEARCH=
MODEL_STRATEGY=
MODEL_EDITOR=
MODEL_PUBLISHER=
EFFORT_PUBLISHER=low

# ── восемь ботов ──────────────────────────────────────────────────────
# У ассистента обязательно /setprivacy → Disable
BOT_ASSISTANT=
BOT_RESEARCH=
BOT_STRATEGY=
BOT_IDEATOR=
BOT_EDITOR=
BOT_REELS=
BOT_DESIGN=
BOT_PUBLISHER=

# ── безопасность ──────────────────────────────────────────────────────
# Через запятую. Пусто = принимать любой чат (только для локальной отладки)
ALLOWED_CHATS=
# Канал для публикации: -100... или @имя.
# Публикатор должен быть в нём администратором с правом постить.
PUBLISH_CHANNEL=

MINIAPP_SECRET=change-me

# ── окружение ─────────────────────────────────────────────────────────
BRANDS_PATH=../content-factory-brands
DB_PATH=./factory.db
DEFAULT_TZ=Europe/Moscow
MINIAPP_URL=
LLM_BUDGET_PER_TENANT_DAY=200
