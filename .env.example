# ── модель ────────────────────────────────────────────────────────────
# Ключа API тут нет намеренно: завод ходит в модель через Claude Code по
# подписке. Один раз выполни `claude` и `/login` в терминале — дальше
# учётные данные живут в Keychain, и заводу они не передаются.
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=high

# Модель и усилие по ролям. Пусто = берётся общее значение выше.
# Только роли, которые зовут модель: assistant, research, strategy,
# editor, reels, design. Публикатор модель отсюда не берёт, а Идеатор
# живёт субагентом Claude Code — своего бота у него нет.
MODEL_RESEARCH=
MODEL_STRATEGY=
MODEL_EDITOR=
# Дизайнер верстает по ТЗ и эталону, а не рассуждает: усилие `high`
# он не отрабатывает, а платит за него временем на каждом круге
# правок. Точечная правка идёт ещё ниже — `design.PATCH_EFFORT`.
EFFORT_DESIGN=medium


# ── семь ботов ──────────────────────────────────────────────────────
# У ассистента обязательно /setprivacy → Disable
BOT_ASSISTANT=
BOT_RESEARCH=
BOT_STRATEGY=
BOT_EDITOR=
BOT_REELS=
BOT_DESIGN=
BOT_PUBLISHER=

# ── распаковщик ───────────────────────────────────────────────────────
# Отдельный бот, личка с клиентом, который заводу ещё не тенант: собирает
# материалы, показывает срез, добирает опросником и пишет папку бренда.
# В «семь ботов» не входит — у него свой диспетчер и своя таблица.
# Пусто — не поднимается, и это норма: собранному бренду он не нужен.
BOT_INTAKE=

# ── безопасность ──────────────────────────────────────────────────────
# Через запятую. Пусто = принимать любой чат (только для локальной отладки)
ALLOWED_CHATS=
# Канал для публикации: -100... или @имя.
# Публикатор должен быть в нём администратором с правом постить.
PUBLISH_CHANNEL=
# Свой профиль Instagram: ник без @ или ссылка. Отсюда в сводку идёт своя
# статистика по Instagram — медиана по лайкам, подписчики, выходы недели.
# В сеть за ним никто не ходит: профиль снимает Chrome человека,
# ./.venv/bin/python tools/instagram_pull.py --profile <ник>
# Пусто — сводка идёт только по Telegram и говорит об этом строкой.
INSTAGRAM_PROFILE=

# Публикация в Instagram через Graph API (Instagram API with Instagram
# Login). Пусто — площадка остаётся ручной. Как получить: SETUP_INSTAGRAM.md
IG_LOGIN=facebook
IG_USER_ID=
IG_TOKEN=
IG_API_VERSION=

# ── окружение ─────────────────────────────────────────────────────────
BRANDS_PATH=../content-factory-brands
DB_PATH=./factory.db
DEFAULT_TZ=Europe/Moscow
LLM_BUDGET_PER_TENANT_DAY=200

# ── чужие рилсы ───────────────────────────────────────────────────────
# Ключ Apify: по нему `tools/trends_pull.py` снимает рилсы по хэштегу и
# по чужому профилю, кладёт в `research/trends/` папки бренда, читает
# `orchestrator/trends.py`. Платно и руками: прогон стоит денег, а тренд
# живёт неделями — фоновый опрос сжигал бы бюджет впустую.
# Пусто — Trend Watcher работает на том кэше, что уже лежит, и говорит
# об этом строкой; выдумывать чужие числа он не станет.
APIFY_TOKEN=
# Акторов два, и род цели выбирает актора. Профиль снимается сеткой
# постов, тег и ключевое слово — хэштег-скрапером: у него есть
# `resultsType: reels`, и это единственный путь к рилсам ниши без
# привязки к чужим профилям. Менять только если актор сменился: у разных
# акторов разные поля на входе, и лишнее поле это отказ, а не игнор.
APIFY_ACTOR=apify~instagram-scraper
APIFY_ACTOR_TAG=apify~instagram-hashtag-scraper


# Ключ HeyGen для tools/heygen_pull.py: говорящая голова в низ сплита,
# когда съёмки нет. Берётся в кабинете HeyGen, Settings → API. Платный:
# тариф считает минуты рендера, инструмент зовётся руками. Пусто —
# инструмент говорит это строкой и в сеть не идёт.
# Обложка понедельничной сводки: Virale в ChatPlace. REST у них нет,
# есть MCP — отсюда адрес сервера рядом с ключом. Ключ заводится на
# странице «Настройки → MCP» кнопкой «Создать ключ» и показывается
# один раз. Пусто — дайджест приходит без обложки, и завод говорит
# это строкой.
CHATPLACE_KEY=
CHATPLACE_MCP=

HEYGEN_API_KEY=
# Аватар и голос по умолчанию. Списки — --avatars и --voices.
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=

# ── анимированный клип в панель ───────────────────────────────────────
# Ключ Higgsfield для tools/higgsfield_pull.py: карточка панели сплита
# идёт сгенерированным движением по тексту расшифровки. Пара «id и
# секрет» берётся в консоли higgsfield.ai, показывается один раз. Пусто
# — инструмент говорит это строкой и в сеть не идёт.
HIGGSFIELD_KEY_ID=
HIGGSFIELD_KEY_SECRET=
# Та же пара одной строкой через двоеточие, если консоль отдала так.
# Заполнена — сильнее двух полей выше.
HIGGSFIELD_CREDENTIALS=
# Модель по умолчанию. Список:
#   ./.venv/bin/python tools/higgsfield_pull.py --models
HIGGSFIELD_MODEL=kling-3
