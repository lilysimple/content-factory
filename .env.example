# ── модель ────────────────────────────────────────────────────────────
# Ключа API тут нет намеренно: завод ходит в модель через Claude Code по
# подписке. Один раз выполни `claude` и `/login` в терминале — дальше
# учётные данные живут в Keychain, и заводу они не передаются.
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=high

# Модель и усилие по ролям. Пусто = берётся общее значение выше.
# Только роли, которые зовут модель: assistant, research, strategy,
# editor, reels, design. Публикатор модель отсюда не берёт, а Идеатор
# живёт субагентом Claude Code — своего бота у него нет.
MODEL_RESEARCH=
MODEL_STRATEGY=
MODEL_EDITOR=
# Дизайнер верстает по ТЗ и эталону, а не рассуждает: усилие `high`
# он не отрабатывает, а платит за него временем на каждом круге
# правок. Точечная правка идёт ещё ниже — `design.PATCH_EFFORT`.
EFFORT_DESIGN=medium


# ── семь ботов ──────────────────────────────────────────────────────
# У ассистента обязательно /setprivacy → Disable
BOT_ASSISTANT=
BOT_RESEARCH=
BOT_STRATEGY=
BOT_EDITOR=
BOT_REELS=
BOT_DESIGN=
BOT_PUBLISHER=

# ── безопасность ──────────────────────────────────────────────────────
# Через запятую. Пусто = принимать любой чат (только для локальной отладки)
ALLOWED_CHATS=
# Канал для публикации: -100... или @имя.
# Публикатор должен быть в нём администратором с правом постить.
PUBLISH_CHANNEL=

# ── окружение ─────────────────────────────────────────────────────────
BRANDS_PATH=../content-factory-brands
DB_PATH=./factory.db
DEFAULT_TZ=Europe/Moscow
LLM_BUDGET_PER_TENANT_DAY=200
